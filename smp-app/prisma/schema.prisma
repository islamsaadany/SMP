  aspiration    String  @default("")
  end_in_mind   String  @default("")
  mission       String  @default("")
  extra         Json    @default("{}")
  tenants       tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "org_tenant")
}

model outcomes {
  tenant_id  String   @db.Uuid
  id         String
  project_id String
  idx        Int
  name       String   @default("")
  dir        String   @default("≥")
  target     String?
  measure_at String?
  actual     String?
  progress   Decimal? @db.Decimal
  note       String?
  extra      Json     @default("{}")
  projects   projects @relation(fields: [tenant_id, project_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "outcomes_project_id_fkey")
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, id])
