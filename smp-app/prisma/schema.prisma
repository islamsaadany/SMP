generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model access_grants {
  tenant_id String  @db.Uuid
  role_key  String
  page_key  String
  grant_    String
  tenants   tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, role_key, page_key])
  @@index([tenant_id], map: "access_grants_tenant")
}

model bands {
  tenant_id String  @db.Uuid
  idx       Int
  key       String
  floor     Int
  label     String  @default("")
  tenants   tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, idx])
  @@index([tenant_id], map: "bands_tenant")
}

model cap_key_objectives {
  tenant_id    String       @db.Uuid
  id           String
  cap_id       String
  idx          Int
  name         String       @default("")
  dir          String       @default("≥")
  target       String?
  compile      String?
  weight       Decimal?     @db.Decimal
  actual       String?
  progress     Decimal?     @db.Decimal
  note         String?
  extra        Json         @default("{}")
  capabilities capabilities @relation(fields: [tenant_id, cap_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "cap_key_objectives_cap_id_fkey")
  tenants      tenants      @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, id])
  @@index([tenant_id], map: "cap_key_objectives_tenant")
}

model capabilities {
  tenant_id          String               @db.Uuid
  id                 String
  idx                Int
  name               String               @default("")
  def                String               @default("")
  fn_key             String?
  extra              Json                 @default("{}")
  cap_key_objectives cap_key_objectives[]
  tenants            tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projects           projects[]

  @@id([tenant_id, id])
  @@index([tenant_id], map: "capabilities_tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cycle {
  tenant_id String  @id @db.Uuid
  name      String  @default("")
  reward_at Decimal @default(100) @db.Decimal
  locked    Boolean @default(false)
  focus     Json    @default("{}")
  extra     Json    @default("{}")
  tenants   tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "cycle_tenant")
}

model deliverables {
  tenant_id  String   @db.Uuid
  id         String
  project_id String
  idx        Int
  name       String   @default("")
  status     String?
  pct        Decimal? @db.Decimal
  note       String?
  extra      Json     @default("{}")
  due        String?
  projects   projects @relation(fields: [tenant_id, project_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "deliverables_project_id_fkey")
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, id])
  @@index([tenant_id], map: "deliverables_tenant")
}

model functions {
  tenant_id   String    @db.Uuid
  key         String
  idx         Int
  name        String    @default("")
  nav_name    String?
  code_prefix String?
  head        String?
  custodian   String?
  active      Boolean   @default(true)
  extra       Json      @default("{}")
  tenants     tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pillars     pillars[]

  @@id([tenant_id, key])
  @@index([tenant_id], map: "functions_tenant")
}

model group_clauses {
  tenant_id String  @db.Uuid
  idx       Int
  label     String  @default("")
  text_     String  @default("")
  cid       String?
  tenants   tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, idx])
  @@index([tenant_id], map: "group_clauses_tenant")
}

model group_key_objectives {
  tenant_id String   @db.Uuid
  idx       Int
  id        String?
  name      String   @default("")
  grp       String?
  dir       String   @default("≥")
  target3y  String?
  target    String?
  compile   String?
  actual    String?
  progress  Decimal? @db.Decimal
  extra     Json     @default("{}")
  tenants   tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, idx])
  @@index([tenant_id], map: "group_key_objectives_tenant")
}

model history {
  tenant_id   String   @db.Uuid
  idx         Int
  name        String   @default("")
  group_score Decimal? @db.Decimal
  units       Json     @default("{}")
  extra       Json     @default("{}")
  tenants     tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, idx])
  @@index([tenant_id], map: "history_tenant")
}

model ko_weights {
  tenant_id String  @db.Uuid
  unit_key  String
