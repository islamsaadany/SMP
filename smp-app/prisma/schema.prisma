/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chat_messages {
  tenant_id    String       @db.Uuid
  id           BigInt       @id @default(autoincrement())
  person_key   String
  at           DateTime     @default(now()) @db.Timestamptz(6)
  from_office  Boolean      @default(false)
  by_key       String
  by_name      String?
  body         String
  shot         String?
  flag         String?
  emailed_to   String?
  bot          Boolean      @default(false)
  source       String?
  handoff      Boolean      @default(false)
  chase_html   String?
  chat_threads chat_threads @relation(fields: [tenant_id, person_key], references: [tenant_id, person_key], onDelete: Cascade, onUpdate: NoAction, map: "chat_messages_person_key_fkey")
  tenants      tenants      @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, id])
  @@index([tenant_id, at], map: "chat_messages_chase", where: raw("((chase_html IS NOT NULL) AND (emailed_to IS NULL))"))
  @@index([tenant_id, flag, at(sort: Desc)], map: "chat_messages_flag", where: raw("(flag IS NOT NULL)"))
  @@index([tenant_id], map: "chat_messages_tenant")
  @@index([tenant_id, person_key, at], map: "chat_messages_thread")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chat_threads {
  tenant_id      String          @db.Uuid
  person_key     String
  person_name    String?
  started_at     DateTime        @default(now()) @db.Timestamptz(6)
  last_at        DateTime        @default(now()) @db.Timestamptz(6)
  waiting        Boolean         @default(true)
  seen_by_them   DateTime?       @db.Timestamptz(6)
  seen_by_us     DateTime?       @db.Timestamptz(6)
  here_at        DateTime?       @db.Timestamptz(6)
  chased_at      DateTime?       @db.Timestamptz(6)
  chased_them_at DateTime?       @db.Timestamptz(6)
  chat_messages  chat_messages[]
  tenants        tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, person_key])
  @@index([tenant_id, last_at(sort: Desc)], map: "chat_threads_last")
  @@index([tenant_id], map: "chat_threads_tenant")
  @@index([tenant_id, waiting, last_at(sort: Desc)], map: "chat_threads_waiting")
}

