}

model people {
  tenant_id    String        @db.Uuid
  key          String
  idx          Int
  name         String        @default("")
  role         String        @default("")
  unit_key     String?
  fn_key       String?
  title        String?
  extra        Json          @default("{}")
  tenants      tenants       @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant_users tenant_users[]

  @@id([tenant_id, key])
  @@index([tenant_id], map: "people_tenant")
}

model pillars {
  tenant_id String     @db.Uuid
  id        String
  unit_key  String?
  idx       Int
  code      String?
  name      String     @default("")
  sub       String?
  kind      String     @default("Direction")
  theme     String?
  owner     String?
  extra     Json       @default("{}")
  fn_key    String?
  measures  measures[]
  functions functions? @relation(fields: [tenant_id, fn_key], references: [tenant_id, key], onDelete: Cascade, onUpdate: NoAction, map: "pillars_fn_key_fkey")
  tenants   tenants    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  units     units?     @relation(fields: [tenant_id, unit_key], references: [tenant_id, key], onDelete: Cascade, onUpdate: NoAction, map: "pillars_unit_key_fkey")
  tactics   tactics[]

  @@id([tenant_id, id])
  @@index([tenant_id, fn_key], map: "pillars_fn_key_idx")
  @@index([tenant_id], map: "pillars_tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model prior_cycle {
  tenant_id String  @id @db.Uuid
  data      Json    @default("{}")
  tenants   tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "prior_cycle_tenant")
}

model projects {
  tenant_id    String         @db.Uuid
  id           String
  cap_id       String
  idx          Int
  name         String         @default("")
  brief        String         @default("")
  owner        String         @default("")
  timeline     String         @default("quarter")
  start_label  String         @default("")
  end_label    String         @default("")
  stakeholders Json?
  extra        Json           @default("{}")
  deliverables deliverables[]
  milestones   milestones[]
  outcomes     outcomes[]
  capabilities capabilities   @relation(fields: [tenant_id, cap_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "projects_cap_id_fkey")
  tenants      tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, id])
  @@index([tenant_id], map: "projects_tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model review {
