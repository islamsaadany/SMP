  tenants   tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, unit_key])
  @@index([tenant_id], map: "ko_weights_tenant")
}

model labels {
  tenant_id String  @db.Uuid
  key       String
  idx       Int
  internal  String  @default("")
  grp       String?
  bu        String?
  note      String?
  extra     Json    @default("{}")
  tenants   tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, key])
  @@index([tenant_id], map: "labels_tenant")
}

model measures {
  tenant_id String   @db.Uuid
  id        String
  pillar_id String
  idx       Int
  name      String   @default("")
  dir       String   @default("≥")
  target    String?
  target3y  String?
  compile   String?
  actual    String?
  progress  Decimal? @db.Decimal
  note      String?
  horizon   String?
  extra     Json     @default("{}")
  pillars   pillars  @relation(fields: [tenant_id, pillar_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "measures_pillar_id_fkey")
