  @@id([tenant_id, id])
  @@index([tenant_id], map: "measures_tenant")
}

model milestones {
  tenant_id  String   @db.Uuid
  id         String
  project_id String
  idx        Int
  name       String   @default("")
  covers     String?
  owner      String?
  finish     String?
  status     String?
  pct        Decimal? @db.Decimal
  note       String?
  extra      Json     @default("{}")
